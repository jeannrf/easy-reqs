{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "predeploy": ["npm run css"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "predeploy": ["node scripts/generar-reglas.mjs"]
  },
  "emulators": {
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "ui": { "enabled": false }
  }
}
